# .env.example pour Production Venus Luna
# Copiez en .env et remplissez vos valeurs

# Sécurité
SECRET_KEY=your-super-secret-key-change-in-prod
DEBUG=False
ALLOWED_HOSTS=venus-luna.com,www.venus-luna.com,localhost,127.0.0.1

# Base de Données PostgreSQL PROD
DATABASE_URL=postgresql://postgres:your-secure-password@your-db-host:5432/venus_luna
DB_NAME=venus_luna
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=your-db-host
DB_PORT=5432

# Cloudinary (obligatoire pour images)
CLOUDINARY_CLOUD_NAME=dse5hwjvt
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password

# Paiements
PAYPLUS_API_KEY=your-payplus-key
PAYPLUS_MERCHANT_ID=your-merchant-id
BKAPAY_PUBLIC_KEY=your-bkapay-key
BKAPAY_SECRET_WEBHOOK=your-webhook-secret

# Réseaux sociaux
WHATSAPP_NUMBER=22893343403
SITE_URL=https://venus-luna.com

